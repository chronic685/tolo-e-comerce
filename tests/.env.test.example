# Copy this file to tests/.env.test (gitignored) and fill in real values.
# In CI, these are set as repository secrets instead of a file.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server-side only — never expose this outside the test runner / CI secrets.
SUPABASE_SERVICE_ROLE_KEY=

# QA-only accounts, created (and clearly labeled "QA TEST") by
# tests/fixtures/ensureQaFixtures.ts on first run. Use passwords you're
# generating just for this — never a real account's password.
QA_MERCHANT_A_EMAIL=qa-merchant-a@toloqa.test
QA_MERCHANT_A_PASSWORD=
QA_MERCHANT_B_EMAIL=qa-merchant-b@toloqa.test
QA_MERCHANT_B_PASSWORD=
QA_CUSTOMER_EMAIL=qa-customer@toloqa.test
QA_CUSTOMER_PASSWORD=
QA_STAFF_EMAIL=qa-staff@toloqa.test
QA_STAFF_PASSWORD=
