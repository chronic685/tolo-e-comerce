# CI only: environment for `supabase functions serve` in .github/workflows/ci.yml.
# Fixed values for the throwaway local stack -- not secrets, same as the QA
# account passwords in that workflow. The Tolo backend here is
# tests/ci/tolo-backend-stub.mjs running on the runner host.
TOLO_BACKEND_URL=http://host.docker.internal:54399
TOLO_BACKEND_SHARED_KEY=ci-tolo-shared-key
TOLO_BACKEND_INBOUND_KEY=ci-tolo-inbound-key
