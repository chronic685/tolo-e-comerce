# Copy to .env (git-ignored). Never commit real values.
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY stay as they are today.

# The new C# API. Locally: http://localhost:5080 (docs: tolo-marketplace-api/docs/run-locally.md).
VITE_API_BASE_URL=http://localhost:5080

# Which backend serves each module: supabase (default) or api. Switch one module at a time.
VITE_BACKEND_CATALOGUE=supabase
VITE_BACKEND_MERCHANT_PRODUCTS=supabase
VITE_BACKEND_ORDERS=supabase
VITE_BACKEND_MERCHANT_ORDERS=supabase
VITE_BACKEND_ADMIN=supabase
VITE_BACKEND_FINANCE=supabase
VITE_BACKEND_CONTENT=supabase

# Development only: to call the API as a signed-in user, paste a dev token in the browser console:
#   localStorage.setItem("tolo.dev_token", "<token>")
# (printed by the API repo: scripts/run-local-staging.ps1). Production builds never read it.
