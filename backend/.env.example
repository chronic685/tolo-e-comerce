# Copy to .env for local development. .env is git-ignored; never commit real values.
# In production these are set in the host's secret store, not in a file.

# Bearer the MARKETPLACE sends to this backend (verify-code, delivery-jobs).
# Must equal the marketplace's TOLO_BACKEND_SHARED_KEY. Unset = every integration call is refused with 503.
TOLO_BACKEND_SHARED_KEY=

# Bearer this backend sends TO the marketplace (merchant-application-status, delivery-status-callback).
# Must equal the marketplace's TOLO_BACKEND_INBOUND_KEY. The two keys are separate so each direction rotates on its own.
TOLO_BACKEND_INBOUND_KEY=

# Base URL of the marketplace's Edge Functions, e.g. https://<project-ref>.supabase.co/functions/v1
MARKETPLACE_FUNCTIONS_URL=

# Postgres URI or Npgsql connection string. Leave empty to run without a database.
# Local dev: the docker-compose "db" service. NEVER the live project from a dev machine.
DATABASE_URL=

# Optional tuning (defaults shown).
# TOLO_LOGIN_CODE_TTL_SECONDS=180
# TOLO_RATE_LIMIT_PER_MINUTE=120
# TOLO_VERIFY_CODE_RATE_LIMIT_PER_MINUTE=30

# Only true behind a proxy that overwrites X-Forwarded-For (otherwise callers can spoof their IP past the rate limiter).
# TOLO_TRUST_FORWARDED_HEADERS=false

# Local dev and tests only: treat the X-Fake-Customer-Id header as the signed-in Tolo customer. Never true anywhere real.
# TOLO_ALLOW_FAKE_APP_AUTH=false
