# Copy to .env for local development. .env is git-ignored; never commit real values.
# In production these are set in the host's secret store, not in a file.

# Postgres URI or Npgsql connection string for the marketplace database. Leave empty to run without one:
# accounts do not exist and every data route answers 503.
# Local dev: the docker-compose "db" service. NEVER the live project from a dev machine.
DATABASE_URL=

# How bearer tokens are verified. ASSUMPTION-BASED until Tolo's developer confirms their token format
# (see docs/backend/tolo-schema-questions.md). With no issuer, audience and key, every token is rejected.
TOLO_JWT_ISSUER=
TOLO_JWT_AUDIENCE=
# Shared secret for HS256 tokens (used as UTF-8 bytes) ...
TOLO_JWT_SIGNING_KEY=
# ... and/or a JWKS URL for RS256/ES256 tokens.
TOLO_JWT_JWKS_URL=

# Bearer for the server-to-server /internal routes (Tolo's backend calling us). Unset = every /internal call is refused with 503.
TOLO_BACKEND_SHARED_KEY=

# Optional tuning (defaults shown).
# TOLO_RATE_LIMIT_PER_MINUTE=120

# Only true behind a proxy that overwrites X-Forwarded-For (otherwise callers can spoof their IP past the rate limiter).
# TOLO_TRUST_FORWARDED_HEADERS=false

# Development environment only (ASPNETCORE_ENVIRONMENT=Development): exposes POST /dev/token, which signs a test token
# with the key above. The app refuses to start with this set in any other environment.
# TOLO_ENABLE_DEV_TOKENS=false
